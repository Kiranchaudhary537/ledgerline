{
  "name": "ledgerline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @acme/api --filter @acme/web dev",
    "build": "pnpm typecheck && pnpm --filter @acme/web build",
    "start": "pnpm --parallel --filter @acme/api --filter @acme/web start",
    "db:migrate": "pnpm --filter @acme/db migrate",
    "db:seed": "pnpm --filter @acme/db seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "bench": "pnpm --filter @acme/api bench",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm --filter @acme/db db:types:check && pnpm test:coverage",
    "ship": "node --env-file-if-exists=.env scripts/ship.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.1"
  }
}
